<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }} — {{ site.description }}</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="Konan David is a choreographer and creative director from Abidjan, Côte d'Ivoire, based in Paris. Worked with Dior, Nike, Vogue, Gazo, Aya Nakamura, Bad Bunny, Travis Scott, and more on live shows, music videos, and brand campaigns.">
    <meta name="keywords" content="Konan David, choreographer Paris,Konan Markosy, David Markosy, Konan David Markosy, chorégraphe paris, chorégraphe hip-hop, chorégraphe hip-hop paris, movement director paris, movement directo côte d'ivoire, creative director, movement director, Ivorian choreographer, Abidjan, Côte d'Ivoire, dance director France, choreographer Gazo, Dior campaign, Nike campaign, Vogue Paris, Aya Nakamura, Bad Bunny, Travis Scott, live show choreography, music video choreography, La Défense Arena, chorégraphe gazo, chorégraphe konan, danseur konan david, chorégraphe konan david, chorégraphe konan, Accor Arena, Dadju, Ama Lou, performance director">
    <meta name="author" content="Konan David">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://konandavid.com">
    
    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://konandavid.com">
    <meta property="og:site_name" content="Konan David">
    <meta property="og:title" content="Konan David - Movement Artist & Choreographer">
    <meta property="og:description" content="Portfolio · Paris">
    <meta property="og:image" content="https://konandavid.com/uploads/og-share-v3.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Aperçu du site konandavid.com">
    <meta property="og:locale" content="en_US">
    <meta property="og:locale:alternate" content="fr_FR">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://konandavid.com">
    <meta name="twitter:title" content="Konan David - Movement Artist & Choreographer">
    <meta name="twitter:description" content="Portfolio · Paris">
    <meta name="twitter:image" content="https://konandavid.com/uploads/og-share-v3.jpg">
    <meta name="twitter:image:alt" content="Aperçu du site konandavid.com">
    <meta name="twitter:creator" content="@konanraw">
    
    {% set faviconUrl = site.favicon if site.favicon else '/uploads/favicon.png' %}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ faviconUrl }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ faviconUrl }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ faviconUrl }}">
    <meta name="theme-color" content="#000000">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% if site.heroPoster %}<link rel="preload" as="image" href="{{ site.heroPoster }}" fetchpriority="high">{% endif %}
    <link rel="preconnect" href="https://player.vimeo.com">
    <link rel="preconnect" href="https://i.vimeocdn.com">
    <link rel="preconnect" href="https://f.vimeocdn.com">
    <link rel="preconnect" href="https://vod-adaptive-ak.vimeocdn.com">
    <link rel="dns-prefetch" href="https://www.youtube.com">
    <!-- Netlify Identity: only loaded when arriving from an invite / password-reset email link (not for regular visitors) -->
    <script>
        if (/(invite_token|recovery_token|confirmation_token|email_change_token|access_token)=/.test(location.hash)) {
            document.write('<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"><\/script>');
        }
    </script>
    <style>
        :root {
            --bg-primary: #000000;
            --bg-secondary: #0a0a0a;
            --bg-tertiary: #111111;
            --text-primary: #f5f5f7;
            --text-secondary: #a1a1a6;
            --text-muted: #6e6e73;
            --accent: #FF6B35;
            --accent-glow: rgba(255, 107, 53, 0.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            overflow-x: clip;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.5;
            overflow-x: clip;
            -webkit-font-smoothing: antialiased;
            position: relative;
            width: 100%;
            max-width: 100vw;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0.025;
            z-index: 10000;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        }

        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 9999;
            padding: 20px 48px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.4s ease;
            background: transparent;
        }

        nav.scrolled {
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: 16px 48px;
        }

        .logo {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--text-primary);
            transition: color 0.3s ease;
        }

        .logo:hover {
            color: var(--accent);
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 32px;
        }

        .nav-links {
            display: flex;
            gap: 36px;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .nav-links a:hover {
            color: var(--accent);
        }

        /* Language Toggle - Premium Style */
        .lang-toggle {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 100px;
            padding: 4px;
            gap: 2px;
        }

        .lang-toggle button {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.05em;
            cursor: pointer;
            padding: 6px 12px;
            border-radius: 100px;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .lang-toggle button:hover {
            color: var(--text-primary);
        }

        .lang-toggle button.active {
            color: var(--text-primary);
            background: rgba(255, 107, 53, 0.15);
        }

        .nav-contact {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 500;
            padding: 10px 20px;
            border: 1px solid rgba(255, 107, 53, 0.5);
            border-radius: 100px;
            transition: all 0.3s ease;
            background: rgba(255, 107, 53, 0.1);
        }

        .nav-contact:hover {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

        .nav-contact svg {
            width: 16px;
            height: 16px;
        }

        /* Mobile Menu */
        .mobile-menu-btn {
            display: none;
            flex-direction: column;
            gap: 5px;
            background: none;
            border: none;
            padding: 8px;
            cursor: pointer;
            z-index: 10000;
        }

        .mobile-menu-btn span {
            width: 22px;
            height: 2px;
            background: var(--text-primary);
            transition: all 0.3s ease;
        }

        .mobile-menu-btn.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
        .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
        .mobile-menu-btn.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

        .mobile-menu {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.98);
            z-index: 9998;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 32px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }

        .mobile-menu.active {
            opacity: 1;
            pointer-events: all;
        }

        .mobile-menu a {
            font-size: 28px;
            font-weight: 600;
            color: var(--text-primary);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .mobile-menu a:hover {
            color: var(--accent);
        }

        .mobile-menu .lang-toggle {
            margin-top: 20px;
            padding: 6px;
        }

        .mobile-menu .lang-toggle button {
            font-size: 14px;
            padding: 10px 20px;
        }

        /* Hero */
        .hero {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 100px 48px 20px;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            width: 140%;
            height: 140%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: radial-gradient(ellipse at 50% 40%, rgba(255, 107, 53, 0.08) 0%, transparent 50%);
            pointer-events: none;
        }

        .hero-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 28px;
            width: 100%;
            max-width: 1200px;
            position: relative;
            z-index: 1;
        }

        /* Showreel */
        .hero-showreel {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            width: 100%;
            max-width: 900px;
            aspect-ratio: 16/9;
            background: #000000;
            box-shadow: 
                0 60px 120px -30px rgba(0, 0, 0, 0.7),
                0 30px 60px -20px rgba(255, 107, 53, 0.12);
        }

        .hero-showreel::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 20px;
            padding: 1px;
            background: linear-gradient(135deg, rgba(255,255,255,0.12), transparent);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            z-index: 2;
        }

        .hero-showreel iframe,
        .hero-showreel video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
            object-fit: cover;
        }

        /* Hero poster + iframe fade-in */
        .hero-poster {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-showreel iframe,
        .hero-showreel video {
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        .hero-showreel iframe.ready,
        .hero-showreel video.ready {
            opacity: 1;
        }

        .hero-poster {
            transition: opacity 0.5s ease;
        }

        /* Self-hosted showreel: visible from the very first frame, no fade */
        .hero-showreel video {
            opacity: 1;
            transition: none;
        }

        .hero-poster.hidden {
            opacity: 0;
        }

        /* Shooting star underline on hero title */
        .title-star {
            position: relative;
            padding-bottom: 10px;
        }

        .title-word {
            transition: color 0.3s ease, text-shadow 0.3s ease;
        }

        .title-word:hover {
            color: var(--text-primary);
            text-shadow: 0 0 24px rgba(255, 255, 255, 0.35);
        }

        .title-sep {
            opacity: 0.5;
        }
    

        .title-star::after {
            content: '';
            position: absolute;
            left: 30%;
            bottom: 0;
            width: 40%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            box-shadow: 0 0 10px rgba(255, 107, 53, 0.8);
            opacity: 0;
            pointer-events: none;
        }


        /* Title */
        .hero-text h1 {
            font-size: clamp(11px, 1.4vw, 16px);
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            line-height: 1.2;
        }

        .hero-text .title-block {
            transition: all 0.4s ease;
        }

        .hero-text .title-block:hover {
            color: var(--text-primary);
            text-shadow: 0 0 30px rgba(255, 107, 53, 0.6), 0 0 60px rgba(255, 107, 53, 0.3);
        }

        .hero-text .separator {
            margin: 0 14px;
            color: var(--accent);
            font-size: 1.1em;
            font-weight: 600;
            text-shadow: 0 0 20px rgba(255, 107, 53, 0.5);
            transition: all 0.4s ease;
        }

        .hero-text .separator:hover {
            transform: scale(1.2) rotate(90deg);
        }

        /* Rotating word hero */
        .title-rotating-wrapper {
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

        .rotating-word-track {
            display: block;
            overflow: hidden;
            height: 1.2em;
            position: relative;
            margin-right: 0.25em;
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            transition: width 0.6s cubic-bezier(0.76, 0, 0.24, 1);
        }

        .rotating-word {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            white-space: nowrap;
            height: 1.2em;
            line-height: 1.2em;
            transition: transform 0.6s cubic-bezier(0.76, 0, 0.24, 1);
            will-change: transform;
        }

        /* Scroll indicator */
        .scroll-indicator {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .scroll-line {
            width: 1px;
            height: 50px;
            background: rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

        .scroll-line::before {
            content: '';
            position: absolute;
            top: -20px;
            left: 0;
            width: 100%;
            height: 20px;
            background: linear-gradient(to bottom, transparent, var(--text-primary), transparent);
            display: none;
        }

        /* Work Section */
        .work-section {
            padding: 40px 48px 60px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 32px;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.6s ease;
        }

        .section-header.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .section-header h2 {
            font-size: clamp(28px, 4vw, 42px);
            font-weight: 600;
            letter-spacing: -0.03em;
        }

        .drag-indicator {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
        }

        .drag-indicator span {
            font-size: 12px;
            color: var(--text-muted);
        }

        .drag-line {
            width: 50px;
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

        .drag-line::before {
            content: '';
            position: absolute;
            left: -20px;
            top: 0;
            width: 20px;
            height: 100%;
            background: linear-gradient(to right, transparent, var(--text-primary), transparent);
            display: none;
        }

        /* Filter bar */
        .filter-bar {
            display: flex;
            gap: 8px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 8px 20px;
            border-radius: 100px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: transparent;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 500;
            font-family: inherit;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.3s ease;
            -webkit-tap-highlight-color: transparent;
        }

        .filter-btn:hover {
            border-color: rgba(255, 255, 255, 0.25);
            color: var(--text-primary);
        }

        .filter-btn.active {
            background: rgba(255, 107, 53, 0.15);
            border-color: rgba(255, 107, 53, 0.4);
            color: var(--text-primary);
        }

        /* Projects wrapper */
        .projects-wrapper {
            position: relative;
            overflow: visible;
        }

        /* Projects container - Safari compatible */
        .projects-container {
            display: flex;
            gap: 28px;
            overflow-x: auto;
            overflow-y: hidden;
            padding: 20px 0 40px;
            margin: 0 -48px;
            padding-left: 48px;
            padding-right: 48px;
            scrollbar-width: none;
            -ms-overflow-style: none;
            scroll-snap-type: x proximity;
            -webkit-overflow-scrolling: touch;
overscroll-behavior-x: contain;
        }

        @media (hover: hover) and (pointer: fine) {
            .projects-container {
                cursor: grab;
            }
        }

        .projects-container::-webkit-scrollbar {
            display: none;
        }

        .projects-container.wheeling {
            scroll-snap-type: none;
        }

        .projects-container.dragging {
            cursor: grabbing;
            scroll-snap-type: none;
            user-select: none;
            -webkit-user-select: none;
        }

        /* Filtered state */
        .project-card.filtered-out {
            display: none;
        }

        /* Project Card - Light smooth glow */
        .project-card {
            width: 400px;
            min-width: 400px;
            flex: 0 0 400px;
            aspect-ratio: 4/5;
            border-radius: 16px;
            overflow: hidden;
            position: relative;
            background: var(--bg-tertiary);
            scroll-snap-align: start;
            /* Light, smooth glow */
            box-shadow: 
                0 4px 16px rgba(0, 0, 0, 0.4),
                0 8px 32px rgba(0, 0, 0, 0.3),
                0 0 60px -20px rgba(255, 107, 53, 0.15);
            transition: all 0.4s ease;
        }

        .project-card:hover {
            transform: translateY(-4px);
            box-shadow: 
                0 8px 24px rgba(0, 0, 0, 0.4),
                0 16px 48px rgba(0, 0, 0, 0.3),
                0 0 80px -15px rgba(255, 107, 53, 0.25);
        }

        .project-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 16px;
            padding: 1px;
            background: rgba(255, 255, 255, 0.08);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            z-index: 5;
            transition: all 0.4s ease;
        }

        .project-card:hover::before {
            background: var(--accent);
        }

        .project-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
            pointer-events: none;
            user-select: none;
            -webkit-user-select: none;
            -webkit-user-drag: none;
        }

        .project-card:hover img {
            transform: scale(1.08);
        }

        .project-info {
            position: absolute;
            inset: 0;
            padding: 28px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.3) 50%, transparent 100%);
            color: white;
            pointer-events: none;
        }

        .project-category {
            position: absolute;
            top: 24px;
            left: 24px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            padding: 6px 12px;
            background: rgba(255, 255, 255, 0.1);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .project-play {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.8);
            width: 70px;
            height: 70px;
            background: rgba(255, 255, 255, 0.2);
            -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: all 0.4s ease;
            border: 1px solid rgba(255, 255, 255, 0.3);
            cursor: pointer;
            z-index: 10;
            pointer-events: auto;
        }

        .project-play::before {
            content: '';
            border-style: solid;
            border-width: 12px 0 12px 20px;
            border-color: transparent transparent transparent white;
            margin-left: 4px;
        }

        .project-card:hover .project-play {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }

        .project-play:hover {
            background: var(--accent);
        }

        /* Touch devices: play always visible, tap reveals info */
        @media (hover: none) {
            .project-play {
                opacity: 1;
                transform: translate(-50%, -50%) scale(0.9);
                width: 54px;
                height: 54px;
            }
            .project-card.show-info .project-description {
                opacity: 1;
                max-height: 200px;
        
            }
            .project-card:hover img { transform: none; }
        }

        .project-artist {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            opacity: 0.85;
            transition: color 0.3s ease;
        }

        .project-card:hover .project-artist {
            color: var(--accent);
        }

        .project-title {
            font-size: 22px;
            font-weight: 600;
            margin-top: 4px;
        }

        .project-role {
            display: inline-block;
            align-self: flex-start;
            margin-top: 10px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: rgba(255, 255, 255, 0.65);
            padding: 4px 12px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 20px;
        }

        .project-description {
            font-size: 13px;
            line-height: 1.6;
            opacity: 0;
            max-height: 0;
            overflow: hidden;
            transition: all 0.5s ease;
            margin-top: 12px;
            color: rgba(255, 255, 255, 0.75);
        }

        .project-card:hover .project-description {
            opacity: 1;
            max-height: 80px;
        }

        /* Scroll arrows */
        .scroll-arrows {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 32px;
        }

        .scroll-arrow {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: transparent;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s ease;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }

        @media (hover: hover) and (pointer: fine) {
            .scroll-arrow:hover {
                border-color: var(--accent);
                background: rgba(255, 107, 53, 0.1);
            }
        }

        .scroll-arrow:active {
            border-color: var(--accent);
            background: rgba(255, 107, 53, 0.15);
        }

        .scroll-arrow:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .scroll-arrow svg {
            width: 20px;
            height: 20px;
            stroke: var(--text-primary);
            fill: none;
            stroke-width: 2;
        }

        /* Video Modal */
        .video-modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.95);
            z-index: 20000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }

        .video-modal.active {
            opacity: 1;
            pointer-events: all;
        }

        .video-modal-content {
            width: 90%;
            max-width: 1100px;
            aspect-ratio: 16/9;
            position: relative;
        }

        .video-modal-content iframe {
            width: 100%;
            height: 100%;
            border: none;
            border-radius: 12px;
        }

        .video-modal-close {
            position: absolute;
            top: -50px;
            right: 0;
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            border-radius: 50%;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .video-modal-close:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .video-modal-close::before,
        .video-modal-close::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 18px;
            height: 2px;
            background: white;
        }

        .video-modal-close::before { transform: translate(-50%, -50%) rotate(45deg); }
        .video-modal-close::after { transform: translate(-50%, -50%) rotate(-45deg); }

        /* Press Section */
        .press-section {
            padding: 40px 0 70px;
            overflow: hidden;
        }

        .press-section::before {
            content: '';
            display: block;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
            margin-bottom: 40px;
        }

        .press-label {
            text-align: center;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--text-muted);
            margin-bottom: 40px;
        }

        .marquee-wrapper {
            position: relative;
            overflow: hidden;
        }

        .marquee-wrapper::before,
        .marquee-wrapper::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 100px;
            z-index: 2;
            pointer-events: none;
        }

        .marquee-wrapper::before {
            left: 0;
            background: linear-gradient(to right, var(--bg-primary), transparent);
        }

        .marquee-wrapper::after {
            right: 0;
            background: linear-gradient(to left, var(--bg-primary), transparent);
        }

        .marquee-track {
            display: flex;
            align-items: center;
            gap: 80px;
            width: max-content;
            animation: marqueeAnim 35s linear infinite;
        }

        .marquee-track:hover {
            animation-play-state: paused;
        }

        @keyframes marqueeAnim {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .press-logo {
            height: 24px;
            opacity: 0.5;
            transition: opacity 0.3s ease;
            filter: brightness(0) invert(1);
        }

        .press-logo:hover {
            opacity: 0.9;
        }

        /* About Section */
        .about-section {
            padding: 100px 48px;
            background: var(--bg-secondary);
            position: relative;
            overflow: hidden;
        }

        .about-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        }

        .about-container {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 0.8fr 1.4fr;
            gap: 80px;
            align-items: center;
        }

        .about-image {
            border-radius: 16px;
            overflow: hidden;
            width: 100%;
            max-width: 320px;
            aspect-ratio: 3/4;
        }

        .about-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .about-label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--accent);
            margin-bottom: 16px;
            font-weight: 600;
        }

        .about-content h2 {
            font-size: clamp(24px, 2.8vw, 32px);
            font-weight: 600;
            margin-bottom: 28px;
            letter-spacing: -0.02em;
        }

        .about-content p {
            font-size: 15px;
            line-height: 1.8;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .about-content strong {
            color: var(--text-primary);
            font-weight: 600;
            transition: color 0.3s ease;
        }

        .about-content strong:hover {
            color: var(--accent);
        }

        /* Contact Section */
        .contact-section {
            padding: 100px 48px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .contact-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        }

        .contact-label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--accent);
            margin-bottom: 16px;
            font-weight: 600;
        }

        .contact-section h2 {
            font-size: clamp(28px, 4.5vw, 48px);
            font-weight: 600;
            margin-bottom: 40px;
            letter-spacing: -0.03em;
        }

        .contact-email {
            display: inline-block;
            font-size: 15px;
            font-weight: 500;
            color: var(--text-primary);
            text-decoration: none;
            padding: 16px 40px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 100px;
            transition: all 0.4s ease;
        }

        .contact-email:hover {
            background: var(--accent);
            border-color: var(--accent);
            box-shadow: 0 0 30px rgba(255, 107, 53, 0.3);
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 40px;
        }

        .social-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .social-links a:hover {
            color: var(--accent);
        }

        /* Footer */
        footer {
            padding: 28px 48px;
            display: flex;
            justify-content: space-between;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 12px;
            color: var(--text-muted);
            overflow: hidden;
        }

        .nav-instagram {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: var(--text-secondary);
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .nav-instagram:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .nav-instagram svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.5;
        }

        .mobile-instagram {
            display: none;
            color: var(--text-primary) !important;
            text-decoration: none;
        }

        /* Mobile lang — texte simple sans pill */
        .mobile-lang {
            display: none;
            align-items: center;
            gap: 4px;
        }

        .mobile-lang button {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.05em;
            cursor: pointer;
            padding: 4px 2px;
            font-family: inherit;
            transition: color 0.3s ease;
        }

        .mobile-lang button.active {
            color: var(--text-primary);
        }

        .mobile-lang .ml-sep {
            color: var(--text-muted);
            font-size: 10px;
        }

        .scroll-label {
            font-size: 9px;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-top: 8px;
        }

        /* Mobile */
        @media (max-width: 1024px) {
            .about-container { grid-template-columns: 1fr; gap: 50px; }
            .about-image { max-width: 280px; margin: 0 auto; }
            .project-card { width: 340px; min-width: 340px; flex: 0 0 340px; }
            .nav-contact span { display: none; }
            .nav-contact { padding: 10px; }
        }

        @media (max-width: 768px) {
            nav { padding: 16px 24px; }
            nav.scrolled { padding: 14px 24px; }
            .nav-links, .nav-contact, .nav-right .lang-toggle, .nav-instagram { display: none; }
            .mobile-menu-btn { display: flex; }
            .mobile-menu { display: flex; }
            .mobile-menu .lang-toggle { display: flex; }
            .mobile-lang { display: flex; }
            .mobile-instagram { display: flex; }
            .hero { padding: 80px 24px 20px; min-height: 100svh; }
            .hero-text h1 { font-size: 9px; letter-spacing: 0.08em; }
            .hero-text .separator { margin: 0 8px; font-size: 1em; }
            .work-section { padding: 10px 24px 60px; }
            .section-header h2 { font-size: 18px; white-space: nowrap; }
            .drag-indicator span { white-space: nowrap; font-size: 10px; }
            .filter-bar { gap: 5px; margin-bottom: 18px; flex-wrap: nowrap; }
            .filter-btn { padding: 6px 10px; font-size: 10px; white-space: nowrap; }
            .filter-btn { padding: 7px 14px; font-size: 11px; }
            .projects-container { 
                margin: 0 -24px; 
                padding-left: 24px; 
                padding-right: 24px;
                gap: 16px;
            }
            .project-card { width: 280px; min-width: 280px; flex: 0 0 280px; }
            .project-title { font-size: 18px; }
            .project-artist { font-size: 11px; }
            .scroll-arrows { gap: 12px; }
            .scroll-arrow { width: 40px; height: 40px; }
            .about-section, .contact-section { padding: 80px 24px; }
            footer { 
                flex-direction: column; 
                gap: 12px; 
                text-align: center; 
                padding: 24px;
            }
        }
        /* =========================================================
           REDESIGN 2026-09 — hero identity + vertical project grid
           (placed last so it overrides the older carousel rules)
           ========================================================= */

        /* Hero: name + role (main H1 for Google) */
        .hero-text { text-align: center; }
        .hero-text .hero-name {
            display: block;
            text-transform: none;
            font-size: clamp(34px, 5.2vw, 64px);
            font-weight: 600;
            letter-spacing: -0.035em;
            line-height: 1;
            color: var(--text-primary);
        }
        .hero-role {
            margin-top: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 12px;
            font-size: clamp(10px, 1.1vw, 13px);
            font-weight: 500;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-secondary);
        }
        .hero-dot {
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 10px var(--accent-glow);
        }

        /* Work: every project visible, vertical grid */
        .work-section { padding: 60px 48px 80px; max-width: 1400px; margin: 0 auto; }
        .projects-container {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
            overflow: visible;
            margin: 0;
            padding: 8px 0 0;
            scroll-snap-type: none;
            cursor: auto;
        }
        .project-card {
            width: auto;
            min-width: 0;
            flex: none;
            scroll-snap-align: none;
        }
        .project-card[data-video] { cursor: pointer; }
        .project-card:hover img { transform: scale(1.04); }

        /* Filters stay reachable while scrolling through the grid */
        .filter-bar {
            position: sticky;
            top: 64px;
            z-index: 50;
            padding: 12px 0;
            margin: 0 0 8px;
            background: linear-gradient(to bottom, var(--bg-primary) 75%, rgba(0,0,0,0));
        }

        /* Soft fade-in (only when JS is running) */
        .reveal-on .project-card { opacity: 0; transform: translateY(18px); }
        .reveal-on .project-card.in {
            opacity: 1;
            transform: none;
            transition: opacity 0.7s ease, transform 0.7s ease, box-shadow 0.4s ease;
        }
        .reveal-on .project-card.in:hover { transform: translateY(-4px); }

        /* Card text sized for the 4-column grid */
        .project-info { padding: 20px; }
        .project-category { top: 16px; left: 16px; font-size: 9px; padding: 5px 10px; }
        .project-artist { font-size: 11px; letter-spacing: 0.06em; }
        .project-title { font-size: 18px; line-height: 1.2; letter-spacing: -0.01em; }
        .project-role { font-size: 9px; padding: 3px 10px; margin-top: 8px; }
        .project-description { font-size: 12px; }
        .project-play { width: 56px; height: 56px; }
        .project-play::before { border-width: 10px 0 10px 16px; }

        /* Visible to Google and screen readers, not on screen */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        @media (max-width: 1280px) {
            .projects-container { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        }

        @media (max-width: 960px) {
            .projects-container { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        @media (max-width: 768px) {
            .hero-text .hero-name { font-size: 34px; letter-spacing: -0.03em; }
            .hero-role { font-size: 9.5px; letter-spacing: 0.14em; gap: 8px; margin-top: 10px; }
            .work-section { padding: 30px 16px 60px; }
            .section-header { margin-bottom: 12px; }
            .section-header h2 { font-size: 24px; }
            .filter-bar {
                top: 56px;
                margin: 0 -16px 6px;
                padding: 10px 16px;
                overflow-x: auto;
                scrollbar-width: none;
            }
            .filter-bar::-webkit-scrollbar { display: none; }
            .projects-container { gap: 10px; margin: 0; padding: 4px 0 0; }
            .project-card { border-radius: 12px; }
            .project-card::before { border-radius: 12px; }
            .project-info { padding: 12px; }
            .project-category { display: none; }
            .project-artist { font-size: 9.5px; letter-spacing: 0.06em; }
            .project-title { font-size: 14px; line-height: 1.2; margin-top: 2px; }
            .project-role {
                margin-top: 8px;
                padding: 3px 10px;
                font-size: 9px;
            }
            .project-description { font-size: 11px; margin-top: 6px; }
            .project-play { width: 38px; height: 38px; top: 38%; }
            .project-play::before { border-width: 8px 0 8px 13px; margin-left: 3px; }
        }

        /* ===== Mosaic (All Work): large 2x2, wide 2x1, standard 1x1, holes auto-filled ===== */
        .projects-wrapper { container-type: inline-size; }
        .projects-container {
            --cols: 4; --gap: 20px; --ratio: 0.75;
            grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
            gap: var(--gap);
            grid-auto-rows: min(calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols) * var(--ratio)), 250px);
            grid-auto-flow: row dense;
        }
        .projects-container .project-card { aspect-ratio: auto; height: 100%; }
        .projects-container .project-card.size-large { grid-column: span 2; grid-row: span 2; }
        .projects-container .project-card.size-wide { grid-column: span 2; }
        .project-card.size-large .project-title { font-size: 28px; }
        .project-card.size-large .project-artist { font-size: 12px; }
        .project-card.size-wide .project-title { font-size: 22px; }
        .projects-container.is-filtered .project-card { grid-column: auto; grid-row: auto; }
        /* Stage / Film & Commercials tabs: projects KD directed = 2:1 (2 columns), performer projects = squares (1 column) */
        .projects-container.is-filtered {
            grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));
            grid-auto-flow: row dense;
        }
        .projects-container.is-filtered .project-card { aspect-ratio: auto; height: 100%; grid-column: span 1; grid-row: auto; }
        .projects-container.is-filtered .project-card[data-direction="1"] { grid-column: span 2; }
        .projects-container.is-filtered .project-card .project-title { font-size: 18px; }
        .projects-container.is-filtered .project-card[data-direction="1"] .project-title { font-size: 24px; }
        @media (max-width: 1280px) { .projects-container { --cols: 3; } }
        @media (max-width: 960px) { .projects-container { --cols: 2; } }
        @media (max-width: 768px) {
            .projects-container { --gap: 10px; --ratio: 1; }
            .projects-container .project-card.size-wide { grid-column: auto; }
            .projects-container .project-card.size-large { grid-row: span 1; }
            .project-card.size-large .project-title { font-size: 18px; }
            .project-card.size-wide .project-title { font-size: 14px; }
            .project-card.size-large .project-title { font-size: 20px; }
            .project-card.size-wide .project-title { font-size: 16px; }
            .projects-container.is-filtered .project-card .project-title,
            .projects-container.is-filtered .project-card[data-direction="1"] .project-title { font-size: 14px; }
        }

        /* ===== Grid v4: one system in every tab =====
           Desktop: 6-column grid. "Grand" = 3:2, 2 per row. "Petit" = 4:3, 3 per row.
           JS (balanceGrid) promotes the last few "Petit" cards to "Grand" when needed so rows are always complete.
           Phone: one project per line, 3:2. */
        .projects-container,
        .projects-container.is-filtered { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: auto; grid-auto-flow: row; }
        .projects-container .project-card { min-height: 0 !important; }
        .projects-container .project-card,
        .projects-container.is-filtered .project-card,
        .projects-container.is-filtered .project-card[data-direction="1"],
        .projects-container .project-card.size-wide { grid-column: span 2; grid-row: auto; aspect-ratio: 4 / 3; height: auto; }
        .projects-container .project-card.size-large.size-large,
        .projects-container .project-card.as-large.as-large,
        .projects-container.is-filtered .project-card.size-large.size-large,
        .projects-container.is-filtered .project-card.as-large.as-large { grid-column: span 3; grid-row: auto; aspect-ratio: 3 / 2; }
        .project-category { display: none !important; }
        .projects-container .project-card .project-title,
        .projects-container.is-filtered .project-card .project-title,
        .projects-container.is-filtered .project-card[data-direction="1"] .project-title { font-size: 20px; }
        .projects-container .project-card.size-large .project-title,
        .projects-container .project-card.as-large .project-title { font-size: 24px; }
        @media (max-width: 768px) {
            .projects-container,
            .projects-container.is-filtered { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
            .projects-container .project-card,
            .projects-container.is-filtered .project-card,
            .projects-container.is-filtered .project-card[data-direction="1"],
            .projects-container .project-card.size-large.size-large,
            .projects-container .project-card.as-large.as-large,
            .projects-container.is-filtered .project-card.size-large.size-large,
            .projects-container.is-filtered .project-card.as-large.as-large { grid-column: auto; aspect-ratio: 3 / 2; }
            .projects-container .project-card .project-title,
            .projects-container .project-card.size-large .project-title,
            .projects-container .project-card.as-large .project-title,
            .projects-container.is-filtered .project-card .project-title,
            .projects-container.is-filtered .project-card[data-direction="1"] .project-title { font-size: 20px; }
        }

        /* Images always fill the whole card (no strip at the bottom) */
        .project-card img { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
        /* Touch screens: no "sticky hover" after a tap — the description only follows the tap toggle */
        @media (hover: none) {
            .project-card:hover .project-description { opacity: 0; max-height: 0; }
            .project-card.show-info .project-description { opacity: 1; max-height: 200px; }
            .project-card:hover, .reveal-on .project-card.in:hover, .project-card:hover img { transform: none; }
        }

        /* Cover framing from /admin: zoom + focus point per project (CSS variables set on the img) */
        .project-card img {
            object-position: var(--pos-x, 50%) var(--pos-y, 50%);
            transform-origin: var(--pos-x, 50%) var(--pos-y, 50%);
            transform: scale(var(--zoom, 1));
        }
        .project-card:hover img { transform: scale(calc(var(--zoom, 1) * 1.04)); }
        @media (hover: none) { .project-card:hover img { transform: scale(var(--zoom, 1)); } }

        /* ===== Calm layout: image clean, caption under it ===== */
        .projects-container,
        .projects-container.is-filtered { column-gap: 28px; row-gap: 48px; }
        .projects-container .project-card,
        .projects-container .project-card.size-large.size-large,
        .projects-container .project-card.as-large.as-large,
        .projects-container.is-filtered .project-card,
        .projects-container.is-filtered .project-card[data-direction="1"],
        .projects-container.is-filtered .project-card.size-large.size-large,
        .projects-container.is-filtered .project-card.as-large.as-large {
            aspect-ratio: auto !important; height: auto; overflow: visible; background: none;
            box-shadow: none !important; border-radius: 0; transform: none !important;
        }
        .projects-container .project-card::before { display: none; }
        .project-media { position: relative; overflow: hidden; border-radius: 6px; aspect-ratio: 4 / 3; background: #111; }
        .project-card.size-large .project-media,
        .project-card.as-large .project-media { aspect-ratio: 3 / 2; }
