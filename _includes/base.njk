<body>
    {{ content | safe }}

    <!-- Video Modal -->
    <div class="video-modal" id="video-modal">
        <div class="video-modal-content">
            <button class="video-modal-close" id="modal-close"></button>
            <iframe id="modal-video" src="" allow="autoplay; fullscreen" allowfullscreen></iframe>
            <img id="modal-cover" class="modal-cover" alt="" hidden>
            <div id="modal-slides" class="modal-slides" hidden>
                <div class="slides-track"></div>
                <button class="slides-nav slides-prev" type="button" aria-label="Previous photo"></button>
                <button class="slides-nav slides-next" type="button" aria-label="Next photo"></button>
                <div class="slides-count"></div>
            </div>
            <div id="modal-info" class="modal-info" hidden></div>
        </div>
    </div>

    <script>
        // ===================
        // LANGUAGE SYSTEM
        // ===================
        let currentLang = localStorage.getItem('lang') || 'en';

        const categoryTranslations = {
            fr: {
                'Live Show': 'Scène',
                'Film & Music Video': 'Film',
                'Commercial': 'Campagne'
            },
            en: {
                'Live Show': 'Stage',
                'Film & Music Video': 'Film',
                'Commercial': 'Campaign'
            }
        };

        function setLanguage(lang) {
            currentLang = lang;
            localStorage.setItem('lang', lang);
            document.documentElement.lang = lang;
            
            // Toggle visibility of language-specific elements
            document.querySelectorAll('[data-lang-en]').forEach(el => {
                el.style.display = lang === 'en' ? '' : 'none';
            });
            document.querySelectorAll('[data-lang-fr]').forEach(el => {
                el.style.display = lang === 'fr' ? '' : 'none';
            });
            
            // Update static translations
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.dataset.i18n;
                if (staticTranslations[lang] && staticTranslations[lang][key]) {
                    el.innerHTML = staticTranslations[lang][key];
                }
            });
            
            // Update active state on all toggle buttons
            document.querySelectorAll('.lang-toggle button, .mobile-lang button').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.lang === lang);
            });

            // Translate category labels on cards
            document.querySelectorAll('.project-card').forEach(card => {
                const rawCategory = card.dataset.category;
                const label = card.querySelector('.project-category');
                if (label && categoryTranslations[lang] && categoryTranslations[lang][rawCategory]) {
                    label.textContent = categoryTranslations[lang][rawCategory];
                }
            });
        }

        // Static translations for UI elements
        const staticTranslations = {
            en: {
                work: 'Work',
                about: 'About',
                contact: 'Contact',
                selectedWork: 'Selected Work',
                dragToExplore: 'Drag to explore',
                featuredIn: 'Featured In & Collaborations',
                copyright: '© 2026 Konan David. All rights reserved.',
                location: 'Paris, France',
                filterAll: 'Selected Work',
                filterDirection: 'Direction',
                filterLive: 'Stage',
                filterFilm: 'Film',
                filterCommercial: 'Campaigns',
                filterScreen: 'Film & Commercials'
            },
            fr: {
                work: 'Projets',
                about: 'À propos',
                contact: 'Contact',
                selectedWork: 'Projets Sélectionnés',
                dragToExplore: 'Glissez pour explorer',
                featuredIn: 'Collaborations & Parutions',
                copyright: '© 2026 Konan David. Tous droits réservés.',
                location: 'Paris, France',
                filterAll: 'Sélection',
                filterDirection: 'Direction',
                filterLive: 'Scène',
                filterFilm: 'Film',
                filterCommercial: 'Campagnes',
                filterScreen: 'Films & Publicités'
            }
        };

        // Initialize language
        document.addEventListener('DOMContentLoaded', () => {
            setLanguage(currentLang);
            
            // Bind click handlers to all language buttons (including mobile-lang)
            document.querySelectorAll('.lang-toggle button, .mobile-lang button').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    setLanguage(btn.dataset.lang);
                });
            });
        });

        // ===================
        // MOBILE MENU
        // ===================
        const mobileMenuBtn = document.querySelector('.mobile-menu-btn');
        const mobileMenu = document.querySelector('.mobile-menu');
        
        mobileMenuBtn?.addEventListener('click', () => {
            mobileMenuBtn.classList.toggle('active');
            mobileMenu.classList.toggle('active');
            document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
        });

        document.querySelectorAll('.mobile-menu a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenuBtn.classList.remove('active');
                mobileMenu.classList.remove('active');
                document.body.style.overflow = '';
            });
        });

        // ===================
        // VIDEO MODAL
        // ===================
        const videoModal = document.getElementById('video-modal');
        const modalVideo = document.getElementById('modal-video');
        const modalCover = document.getElementById('modal-cover');
        const modalInfo = document.getElementById('modal-info');

        // Description of the clicked project, shown under the video (or under the cover if there is no video)
        function fillModalInfo(card) {
            const aside = card && card.querySelector('.project-aside');
            if (!modalInfo) return;
            if (!aside) { modalInfo.hidden = true; modalInfo.innerHTML = ''; return; }
            const head = document.createElement('div');
            const body = document.createElement('div');
            aside.querySelectorAll('.aside-artist, .aside-title, .aside-role').forEach(el => head.appendChild(el.cloneNode(true)));
            aside.querySelectorAll('.aside-desc').forEach(el => body.appendChild(el.cloneNode(true)));
            const plus = document.createElement('button');
            plus.type = 'button';
            plus.className = 'info-plus';
            plus.setAttribute('aria-label', 'Description');
            plus.addEventListener('click', (e) => { e.stopPropagation(); videoModal.classList.toggle('info-open'); });
            modalInfo.innerHTML = '';
            modalInfo.append(head, body, plus);
            modalInfo.hidden = false;
            videoModal.classList.remove('info-open');
        }
        const modalSlides = document.getElementById('modal-slides');
        const slides = { imgs: [], i: 0, timer: null };
        function showSlide(n) {
            if (!slides.imgs.length) return;
            slides.i = (n + slides.imgs.length) % slides.imgs.length;
            slides.imgs.forEach((im, k) => im.classList.toggle('is-active', k === slides.i));
            const count = modalSlides.querySelector('.slides-count');
            if (count) count.textContent = (slides.i + 1) + ' / ' + slides.imgs.length;
        }
        function restartSlides() {
            clearInterval(slides.timer);
            if (slides.imgs.length > 1) slides.timer = setInterval(() => showSlide(slides.i + 1), 3500);
        }
        function stopSlides() {
            clearInterval(slides.timer); slides.timer = null; slides.imgs = [];
            if (modalSlides) { modalSlides.hidden = true; modalSlides.querySelector('.slides-track').innerHTML = ''; }
        }
        function closeModal() {
            videoModal.classList.remove('active', 'info-open');
            modalVideo.src = '';
            if (modalCover) { modalCover.hidden = true; modalCover.removeAttribute('src'); }
            stopSlides();
            document.body.style.overflow = '';
        }
        function openCoverOnly(card) {
            const img = card.querySelector('.project-media img');
            modalVideo.src = '';
            modalVideo.hidden = true;
            if (modalCover) modalCover.hidden = true;
            stopSlides();
            const gallery = (card.dataset.gallery || '').split('|').filter(Boolean);
            if (gallery.length && modalSlides) {
                const cover = img ? img.getAttribute('src') : null;
                const list = cover && !gallery.includes(cover) ? [cover, ...gallery] : gallery;
                const track = modalSlides.querySelector('.slides-track');
                slides.imgs = list.map((src, k) => {
                    const slide = document.createElement('div');
                    slide.className = 'slide';
                    const bg = document.createElement('img');
                    bg.className = 'slide-bg'; bg.src = src; bg.alt = ''; bg.setAttribute('aria-hidden', 'true');
                    const fg = document.createElement('img');
                    fg.className = 'slide-fg'; fg.src = src; fg.alt = (img ? img.alt : '') + ' — ' + (k + 1);
                    slide.append(bg, fg);
                    track.appendChild(slide);
                    return slide;
                });
                modalSlides.querySelectorAll('.slides-nav').forEach(b => b.hidden = slides.imgs.length < 2);
                modalSlides.hidden = false;
                showSlide(0);
                restartSlides();
            } else if (modalCover && img) {
                modalCover.src = img.currentSrc || img.src; modalCover.alt = img.alt; modalCover.hidden = false;
            }
            fillModalInfo(card);
            videoModal.scrollTop = 0;
            videoModal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        modalSlides?.querySelector('.slides-prev')?.addEventListener('click', (e) => { e.stopPropagation(); showSlide(slides.i - 1); restartSlides(); });
        modalSlides?.querySelector('.slides-next')?.addEventListener('click', (e) => { e.stopPropagation(); showSlide(slides.i + 1); restartSlides(); });
        document.addEventListener('keydown', (e) => {
            if (!videoModal?.classList.contains('active') || !slides.imgs.length) return;
            if (e.key === 'ArrowRight') { showSlide(slides.i + 1); restartSlides(); }
            if (e.key === 'ArrowLeft') { showSlide(slides.i - 1); restartSlides(); }
        });
        let touchX = null;
        modalSlides?.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
        modalSlides?.addEventListener('touchend', (e) => {
            if (touchX === null) return;
            const dx = e.changedTouches[0].clientX - touchX; touchX = null;
            if (Math.abs(dx) > 40) { showSlide(slides.i + (dx < 0 ? 1 : -1)); restartSlides(); }
        });
        document.querySelectorAll('.project-play').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const url = btn.closest('.project-card')?.dataset.video;
                if (url) {
                    let embed = url;
                    const yt = url.match(/(?:youtube\.com\/watch\?(?:.*&)?v=|youtu\.be\/)([\w-]{11})/);
                    const ytStart = (url.match(/[?&](?:t|start)=(\d+)/) || [])[1];
                    if (yt) embed = `https://www.youtube.com/embed/${yt[1]}?autoplay=1${ytStart ? `&start=${ytStart}` : ''}`;
                    else if (url.includes('vimeo.com/')) embed = `https://player.vimeo.com/video/${url.split('vimeo.com/')[1]}?autoplay=1`;
                    modalVideo.hidden = false;
                    if (modalCover) modalCover.hidden = true;
                    stopSlides();
                    modalVideo.src = embed;
                    fillModalInfo(btn.closest('.project-card'));
                    videoModal.scrollTop = 0;
                    videoModal.classList.add('active');
                    document.body.style.overflow = 'hidden';
                }
            });
        });

        document.getElementById('modal-close')?.addEventListener('click', closeModal);

        videoModal?.addEventListener('click', (e) => {
            if (e.target === videoModal) closeModal();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && videoModal?.classList.contains('active')) closeModal();
        });

        // Projects without a video: a click opens the cover with the description underneath
        document.querySelectorAll('.project-card:not([data-video])').forEach(card => {
            if (!card.querySelector('.project-aside') && !card.dataset.gallery) return;
            card.setAttribute('data-info', '');
            card.addEventListener('click', () => openCoverOnly(card));
        });

        // ===================
        // HERO SCROLL EFFECTS
        // ===================
        const heroShowreel = document.getElementById('hero-showreel');
        const heroText = document.getElementById('hero-text');
        const scrollIndicator = document.querySelector('.scroll-indicator');

        function handleScroll() {
            const y = window.scrollY;
            
            const showreelOpacity = Math.max(0, 1 - (y / 400));
            const titleOpacity = Math.max(0, Math.min(1, 1 - ((y - 200) / 300)));
            const indicatorOpacity = Math.max(0, Math.min(1, 1 - ((y - 350) / 200)));
            
            if (heroShowreel) {
                heroShowreel.style.opacity = showreelOpacity;
                heroShowreel.style.transform = `scale(${1 + (1 - showreelOpacity) * 0.1})`;
            }
            if (heroText) heroText.style.opacity = titleOpacity;
            if (scrollIndicator) scrollIndicator.style.opacity = indicatorOpacity;
            
            document.querySelector('nav')?.classList.toggle('scrolled', y > 100);
        }

        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll();

        // ===================
        // SECTION REVEAL
        // ===================
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => e.isIntersecting && e.target.classList.add('visible'));
        }, { threshold: 0.1 });

        document.querySelectorAll('.section-header').forEach(el => observer.observe(el));

        // ===================
        // PROJECT SCROLL ARROWS
        // ===================
        const container = document.querySelector('.projects-container');
        const leftArrow = document.getElementById('scroll-left');
        const rightArrow = document.getElementById('scroll-right');

        leftArrow?.addEventListener('click', () => container.scrollBy({ left: -400, behavior: 'smooth' }));
        rightArrow?.addEventListener('click', () => container.scrollBy({ left: 400, behavior: 'smooth' }));

        function updateArrows() {
            if (!container) return;
            if (leftArrow) leftArrow.disabled = container.scrollLeft <= 0;
            if (rightArrow) rightArrow.disabled = container.scrollLeft >= container.scrollWidth - container.clientWidth - 10;
        }
        
        container?.addEventListener('scroll', updateArrows);

        // Cards: horizontal scroll via drag, arrows or horizontal trackpad gesture; vertical wheel scrolls the page
        updateArrows();

        // Touch: tap a card to reveal its description
        if (('ontouchstart' in window) || navigator.maxTouchPoints > 0) {
            document.querySelectorAll('.project-card').forEach(card => {
                card.addEventListener('click', (e) => {
                    if (e.target.closest('.project-play')) return;
                    // Captions are under the image now: a tap on the card opens its video
                    card.querySelector('.project-play')?.click();
                });
            });
            // Tap anywhere outside a card closes the open description
            document.addEventListener('click', (e) => {
                if (e.target.closest('.project-card')) return;
                document.querySelectorAll('.project-card.show-info').forEach(c => c.classList.remove('show-info'));
            });
        }

        // Desktop: clicking anywhere on a card opens its video
        if (!(('ontouchstart' in window) || navigator.maxTouchPoints > 0)) {
            document.querySelectorAll('.project-card[data-video]').forEach(card => {
                card.addEventListener('click', (e) => {
                    if (e.target.closest('.project-play')) return;
                    card.querySelector('.project-play')?.click();
                });
            });
        }

        // Cards fade in softly as they enter the screen
        if ('IntersectionObserver' in window) {
            document.documentElement.classList.add('reveal-on');
            const cardObserver = new IntersectionObserver((entries) => {
                entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); cardObserver.unobserve(e.target); } });
            }, { rootMargin: '0px 0px -8% 0px' });
            document.querySelectorAll('.project-card').forEach(c => cardObserver.observe(c));
        }

        // Hero showreel: the poster shows instantly, the Vimeo player loads only once the page is ready
        const heroIframe = document.getElementById('hero-video');
        // Reveal the video the moment Vimeo reports it is actually playing (no black frame, no fixed wait)
        let heroRevealed = false;
        function revealHeroVideo() {
            if (heroRevealed || !heroIframe) return;
            heroRevealed = true;
            heroIframe.classList.add('ready');
            document.querySelector('.hero-poster')?.classList.add('hidden');
        }
        window.addEventListener('message', (e) => {
            if (!heroIframe || e.source !== heroIframe.contentWindow || !/vimeo\.com$/.test(new URL(e.origin).hostname)) return;
            let data = e.data;
            try { if (typeof data === 'string') data = JSON.parse(data); } catch (err) { return; }
            if (data.event === 'ready') {
                ['play', 'playProgress', 'timeupdate'].forEach(ev => heroIframe.contentWindow.postMessage(JSON.stringify({ method: 'addEventListener', value: ev }), e.origin));
            } else if (data.event === 'play' || data.event === 'playProgress' || data.event === 'timeupdate') {
                revealHeroVideo();
            }
        });
        if (heroIframe && heroIframe.tagName === 'VIDEO') {
            // Self-hosted showreel: show it as soon as the first frames play
            heroIframe.addEventListener('playing', revealHeroVideo, { once: true });
            if (!heroIframe.paused && heroIframe.readyState >= 3) revealHeroVideo();
            heroIframe.play?.().catch(() => {});
        }
        heroIframe?.addEventListener('load', () => {
            if (heroIframe.tagName === 'VIDEO' || !heroIframe.getAttribute('src')) return;
            setTimeout(revealHeroVideo, 2500); // safety net if Vimeo events don't arrive
        });
        function loadHeroVideo() {
            if (heroIframe && !heroIframe.getAttribute('src') && heroIframe.dataset.src) {
                heroIframe.src = heroIframe.dataset.src;
            }
        }
        loadHeroVideo(); // start loading right away instead of waiting for the whole page
        updateArrows();

        // ===================
        // MOUSE DRAG TO SCROLL (desktop only, not touch)
        // ===================
        // (Disabled: projects are now a vertical grid, no horizontal drag needed)
        if (false && container) {
            const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
            let isDragging = false;
            let startX = 0;
            let scrollStart = 0;
            let hasMoved = false;

            if (!isTouchDevice) {
                container.addEventListener('mousedown', function(e) {
                    if (e.target.closest('.project-play')) return;
                    isDragging = true;
                    hasMoved = false;
                    startX = e.pageX;
                    scrollStart = container.scrollLeft;
                    container.classList.add('dragging');
                    e.preventDefault();
                });

                window.addEventListener('mousemove', function(e) {
                    if (!isDragging) return;
                    const dx = e.pageX - startX;
                    if (Math.abs(dx) > 3) hasMoved = true;
                    container.scrollLeft = scrollStart - dx;
                    updateArrows();
                });

                window.addEventListener('mouseup', function() {
                    if (!isDragging) return;
                    isDragging = false;
                    container.classList.remove('dragging');
                });

                container.addEventListener('click', function(e) {
                    if (hasMoved) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                }, true);
            }
        }

        // ===================
        // DRAG/SWIPE INDICATOR TEXT
        // ===================
        (function() {
            const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
            if (isTouchDevice) {
                document.querySelectorAll('[data-i18n="dragToExplore"]').forEach(el => {
                    el.textContent = currentLang === 'fr' ? 'Swipez pour explorer' : 'Swipe to explore';
                });
                // Also update the translations so language switch works
                staticTranslations.en.dragToExplore = 'Swipe to explore';
                staticTranslations.fr.dragToExplore = 'Swipez pour explorer';
            }
        })();

        // Selected Work: the first 2 projects (in the order set in the admin) are shown big, side by side; the rest go 3 per row.
        // Tabs (Stage, Film & Commercials): every card the same size.
        function fillMobileGrid() {
            const grid = document.querySelector('.projects-container');
            if (!grid) return;
            const cards = [...grid.querySelectorAll('.project-card')];
            cards.forEach(c => { c.classList.remove('as-large', 'fill-full', 'sw-top'); c.style.gridColumn = ''; });
            if (grid.classList.contains('is-filtered')) return;
            const visible = cards.filter(c => !c.classList.contains('filtered-out'))
                .sort((a, b) => (Number(a.style.order) || 0) - (Number(b.style.order) || 0));
            visible.slice(0, 2).forEach(c => c.classList.add('sw-top'));
        }
        fillMobileGrid();
        let fillTimer;
        window.addEventListener('resize', () => { clearTimeout(fillTimer); fillTimer = setTimeout(fillMobileGrid, 150); });

        // ===================
        // PROJECT FILTERS
        // ===================
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const filter = btn.dataset.filter;
                
                // Update active state
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                
                // Filter cards
                const cards = document.querySelectorAll('.project-card');
                cards.forEach(card => {
                    if ((filter === 'all' && card.dataset.featured === '1') || card.dataset.category === filter || (filter === 'screen' && card.dataset.screen === '1') || (filter === 'direction' && card.dataset.direction === '1')) {
                        card.classList.remove('filtered-out');
                    } else {
                        card.classList.add('filtered-out');
                    }
                });

                // Per-tab order: "Position" fields from /admin win, otherwise the list order
                cards.forEach(card => {
                    const pos = filter === 'all' ? null : (filter === 'direction' ? card.dataset.orderDirection : filter === 'screen' ? card.dataset.orderScreen : card.dataset.orderCategory);
                    card.style.order = filter === 'all' ? '' : String(pos ? Number(pos) : 1000 + Number(card.dataset.index || 0));
                });
                const grid = document.querySelector('.projects-container');
                if (grid) { grid.scrollLeft = 0; grid.classList.toggle('is-filtered', filter !== 'all'); }
                fillMobileGrid();
                
                // Bring the top of the grid back into view if the visitor had scrolled past it
                const workTop = document.getElementById('work').getBoundingClientRect().top;
                if (workTop < 0) document.getElementById('work').scrollIntoView({ behavior: 'smooth' });
            });
        });

        // ===================
        // SMOOTH SCROLL NAV
        // ===================
        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', (e) => {
                e.preventDefault();
                document.querySelector(a.getAttribute('href'))?.scrollIntoView({ behavior: 'smooth' });
            });
        });

        // ===================
        // SHOWREEL SOUND
        // ===================
        const heroVideo = document.getElementById('hero-video');
        let soundOn = false;
        heroShowreel?.addEventListener('click', () => {
            if (heroVideo && heroVideo.tagName === 'VIDEO') {
                heroVideo.muted = !heroVideo.muted;
                if (!heroVideo.muted) heroVideo.play().catch(() => {});
                return;
            }
            if (!soundOn && heroVideo) {
                heroVideo.src = (heroVideo.getAttribute('src') || heroVideo.dataset.src).replace('muted=1', 'muted=0');
                soundOn = true;
            }
        });

        // ===================
        // ROTATING WORD HERO
        // ===================
        (function() {
            const track = document.querySelector('.rotating-word-track');
            const words = document.querySelectorAll('.rotating-word');
            if (!words.length || !track) return;

            const total = words.length;
            let current = 0;

            // Disable transitions to measure + set initial state
            words.forEach(w => {
                w.style.transition = 'none';
            });
            track.style.transition = 'none';

            requestAnimationFrame(() => {
                const widths = Array.from(words).map(w => w.offsetWidth);

                // Stack words below each other from the start
                words.forEach((w, i) => {
                    w.style.transform = `translateY(${i * 1.2}em)`;
                });

                // Track width = first word
                track.style.width = widths[0] + 'px';

                function rotateTo(index) {
                    // Shift all words up so current word sits at 0
                    words.forEach((w, i) => {
                        w.style.transform = `translateY(${(i - index) * 1.2}em)`;
                    });
                    track.style.width = widths[index] + 'px';
                }

                // Enable transitions after first paint
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        words.forEach(w => {
                            w.style.transition = 'transform 0.6s cubic-bezier(0.76, 0, 0.24, 1)';
                        });
                        track.style.transition = 'width 0.6s cubic-bezier(0.76, 0, 0.24, 1)';
                    });
                });

                setInterval(() => {
                    current = (current + 1) % total;
                    rotateTo(current);
                }, 1300);
            });
        })();
    </script>

    <!-- Netlify Identity Redirect -->
    <script>
        if (window.netlifyIdentity) {
            window.netlifyIdentity.on("init", user => {
                if (!user) {
                    window.netlifyIdentity.on("login", () => {
                        document.location.href = "/admin/";
                    });
                }
            });
        }
    </script>
    <script>
        // ===================
        // ANALYTICS EVENTS (Umami) — what visitors click
        // ===================
        document.addEventListener('click', function (e) {
            var track = function (name, data) { try { if (window.umami) window.umami.track(name, data); } catch (err) {} };
            var t = e.target;
            var card = t.closest && t.closest('.project-card');
            if (card) {
                var title = (card.querySelector('img') || {}).alt || '';
                track(t.closest('.project-play') ? 'Video play' : 'Project click', { project: title });
                return;
            }
            var filter = t.closest('.filter-btn');
            if (filter) { track('Filter tab', { tab: filter.textContent.trim() }); return; }
            var lang = t.closest('[data-lang]');
            if (lang) { track('Language', { lang: lang.dataset.lang }); return; }
            if (t.closest('#hero-showreel')) { track('Showreel click'); return; }
            var a = t.closest('a[href]');
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (href.indexOf('mailto:') === 0) track('Contact email');
            else if (href.indexOf('instagram.com') !== -1) track('Instagram click');
            else if (href.indexOf('youtube.com') !== -1 || href.indexOf('youtu.be') !== -1) track('YouTube click');
            else if (href === '#contact') track('Contact button');
        }, true);
    </script>
    <script>
        // Logos marquee: runs on its own, speeds up with page scroll, can be dragged or flicked left/right
        (function () {
            const wrap = document.querySelector('.marquee-wrapper');
            const track = wrap && wrap.querySelector('.marquee-track');
            if (!track || !window.requestAnimationFrame) return;
            const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            wrap.classList.add('is-live'); track.classList.add('is-live');
            // x = how far the logos have travelled to the left; it loops every half track (the list is doubled)
            let half = track.scrollWidth / 2, x = 0, boost = 0, dir = 1, hover = false, dragging = false;
            let lastT = performance.now(), lastX = 0, lastMoveT = 0, dragV = 0, startX = 0, startPos = 0;
            const measure = () => { half = track.scrollWidth / 2; };
            window.addEventListener('resize', measure);
            window.addEventListener('load', measure);
            if ('ResizeObserver' in window) new ResizeObserver(measure).observe(track); // logos load lazily
            // Page scroll pushes the logos: down = left, up = right
            let lastScroll = window.scrollY;
            window.addEventListener('scroll', () => {
                const d = window.scrollY - lastScroll; lastScroll = window.scrollY;
                if (reduce || !d) return;
                boost = Math.max(-2600, Math.min(2600, boost + d * 7));
                dir = d > 0 ? 1 : -1;
            }, { passive: true });
            // Horizontal trackpad swipe over the logos moves them directly
            wrap.addEventListener('wheel', (e) => {
                if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
                e.preventDefault();
                boost = Math.max(-3000, Math.min(3000, boost + e.deltaX * 14));
                dir = e.deltaX > 0 ? 1 : -1;
            }, { passive: false });
            wrap.addEventListener('mouseenter', () => { hover = true; });
            wrap.addEventListener('mouseleave', () => { hover = false; });
            // Grab and drag (mouse or finger), let go to flick
            wrap.addEventListener('pointerdown', (e) => {
                dragging = true; wrap.classList.add('dragging');
                startX = lastX = e.clientX; startPos = x; lastMoveT = performance.now(); dragV = 0; boost = 0;
                if (wrap.setPointerCapture) wrap.setPointerCapture(e.pointerId);
            });
            wrap.addEventListener('pointermove', (e) => {
                if (!dragging) return;
                const now = performance.now(), dt = Math.max(8, now - lastMoveT);
                dragV = (e.clientX - lastX) / dt * 1000; lastX = e.clientX; lastMoveT = now;
                x = startPos - (e.clientX - startX);
            });
            const endDrag = () => {
                if (!dragging) return;
                dragging = false; wrap.classList.remove('dragging');
                if (performance.now() - lastMoveT > 120) dragV = 0; // held still before letting go: no flick
                boost = Math.max(-4000, Math.min(4000, -dragV));
                if (dragV) dir = dragV > 0 ? -1 : 1;
            };
            wrap.addEventListener('pointerup', endDrag);
            wrap.addEventListener('pointercancel', endDrag);
            function tick(t) {
                const dt = Math.min(0.05, (t - lastT) / 1000); lastT = t;
                if (!dragging) {
                    const cruise = (half / 35) * (reduce ? 0.4 : 1) * (hover ? 0.3 : 1);
                    x += (dir * cruise + boost) * dt;
                    boost *= Math.pow(0.05, dt); // the push fades out in about a second
                    if (Math.abs(boost) < 1) boost = 0;
                }
                if (half > 0) x = ((x % half) + half) % half;
                track.style.transform = 'translate3d(' + (-x) + 'px,0,0)';
                requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        })();
    </script>
