        /* ===== Descriptions: never written over the image ===== */
        .project-card .project-overlay { display: none !important; }
        .project-aside { display: none; }
        /* Click on a project: video (or cover) in the modal, description underneath */
        .project-card[data-info] { cursor: pointer; }
        .video-modal { overflow-y: auto; padding: 70px 0 40px; align-items: flex-start; }
        .video-modal-content { aspect-ratio: auto; width: min(90%, 1100px, calc((100vh - 300px) * 16 / 9)); min-width: min(90%, 560px); margin: auto; }
        .video-modal-content iframe { display: block; height: auto; aspect-ratio: 16 / 9; }
        .video-modal-content iframe[hidden] { display: none; }
        .modal-cover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; }
        .modal-cover[hidden] { display: none; }
        /* Photo slideshow (projects without video) */
        .modal-slides { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #050505; touch-action: pan-y; }
        .modal-slides[hidden] { display: none; }
        .modal-slides .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.9s ease; }
        .modal-slides .slide.is-active { opacity: 1; }
        .modal-slides .slide img { position: absolute; inset: 0; width: 100%; height: 100%; }
        .modal-slides .slide .slide-bg { object-fit: cover; filter: blur(28px) brightness(0.45); transform: scale(1.15); }
        .modal-slides .slide .slide-fg { object-fit: contain; }
        .slides-nav { position: absolute; top: 50%; z-index: 2; width: 44px; height: 44px; margin-top: -22px; border: none; border-radius: 50%; background: rgba(0,0,0,0.45); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); cursor: pointer; opacity: 0; transition: opacity 0.3s ease, background 0.3s ease; }
        .modal-slides:hover .slides-nav { opacity: 1; }
        .slides-nav:hover { background: var(--accent); }
        .slides-nav::before { content: ''; position: absolute; top: 50%; left: 50%; width: 10px; height: 10px; border-top: 2px solid #fff; border-right: 2px solid #fff; }
        .slides-prev { left: 16px; } .slides-prev::before { transform: translate(-30%, -50%) rotate(-135deg); }
        .slides-next { right: 16px; } .slides-next::before { transform: translate(-70%, -50%) rotate(45deg); }
        .slides-count { position: absolute; right: 16px; bottom: 14px; z-index: 2; padding: 5px 10px; border-radius: 999px; background: rgba(0,0,0,0.5); font-size: 11px; letter-spacing: 0.08em; color: rgba(255,255,255,0.85); }
        @media (hover: none) { .slides-nav { opacity: 1; width: 36px; height: 36px; margin-top: -18px; } }
        /* Card badge for projects with a photo slideshow */
        .project-photos { position: absolute; top: 50%; left: 50%; z-index: 3; width: 70px; height: 70px; transform: translate(-50%, -50%) scale(0.8); border-radius: 50%; background: rgba(255,255,255,0.2); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3); opacity: 0; transition: all 0.4s ease; pointer-events: none; }
        .project-photos span { display: none; }
        .project-photos::before, .project-photos::after { content: ''; position: absolute; top: 50%; left: 50%; width: 20px; height: 15px; border: 2px solid #fff; border-radius: 2px; }
        .project-photos::before { transform: translate(-40%, -40%); }
        .project-photos::after { transform: translate(-65%, -65%); border-color: rgba(255,255,255,0.55); border-right-color: transparent; border-bottom-color: transparent; }
        .project-card:hover .project-photos { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        @media (hover: none) { .project-photos { opacity: 0.9; transform: translate(-50%, -50%) scale(0.75); } }
        /* Info line under the video: ARTIST | Project / role underneath, description behind the + */
        .video-modal { background: #000; }
        .video-modal-content { margin: 0 auto; }
        .modal-info { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: "artist title btn" "artist role btn" "desc desc desc"; align-items: center; column-gap: 18px; padding: 22px 2px 0; }
        .modal-info[hidden] { display: none; }
        .modal-info > div:first-child { display: contents; }
        .modal-info .aside-artist { grid-area: artist; align-self: stretch; display: flex; align-items: center; padding-right: 18px; border-right: 1px solid rgba(255,255,255,0.18); font-size: 15px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; }
        .modal-info .aside-title { grid-area: title; font-size: 17px; font-weight: 400; color: rgba(255,255,255,0.9); line-height: 1.25; }
        .modal-info .aside-role { grid-area: role; margin-top: 5px; font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
        .modal-info .aside-role[style*="none"], .modal-info .aside-desc[style*="none"] { display: none !important; }
        .modal-info > div:nth-child(2) { grid-area: desc; max-width: 760px; max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.5s ease, opacity 0.4s ease, padding 0.4s ease; }
        .video-modal.info-open .modal-info > div:nth-child(2) { max-height: 400px; opacity: 1; padding-top: 20px; }
        .modal-info .aside-desc { margin: 0; font-size: 14px; line-height: 1.7; color: rgba(255,255,255,0.78); }
        .info-plus { grid-area: btn; position: relative; width: 30px; height: 30px; padding: 0; border: 1px solid rgba(255,255,255,0.3); border-radius: 50%; background: none; cursor: pointer; transition: border-color 0.3s, background 0.3s, transform 0.4s; }
        .info-plus::before, .info-plus::after { content: ''; position: absolute; top: 50%; left: 50%; width: 11px; height: 1.5px; background: #fff; transform: translate(-50%, -50%); }
        .info-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
        .info-plus:hover { border-color: var(--accent); background: rgba(255,107,53,0.12); }
        .video-modal.info-open .info-plus { transform: rotate(45deg); }
        @media (max-width: 768px) {
            .video-modal { padding: 80px 0 32px; }
            .video-modal-content { width: calc(100% - 32px); min-width: 0; }
            .modal-info { column-gap: 14px; padding-top: 18px; }
            .modal-info .aside-artist { padding-right: 14px; font-size: 13px; }
            .modal-info .aside-title { font-size: 15px; }
            .modal-info .aside-desc { font-size: 13.5px; }
        }
        /* Phone: play button centred on the image */
        @media (max-width: 768px) {
            .project-card .project-media .project-play { top: 50%; left: 50%; }
        }

        /* Logos marquee: driven by JS (drag, flick, scroll boost); CSS animation only as fallback */
        .marquee-track.is-live { animation: none; will-change: transform; }
        .marquee-wrapper.is-live { cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
        .marquee-wrapper.is-live.dragging { cursor: grabbing; }
        .marquee-wrapper.is-live .press-logo { -webkit-user-drag: none; pointer-events: none; }
