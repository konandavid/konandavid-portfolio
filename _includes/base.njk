        .project-card .project-text { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 6px; }
        .projects-container .project-card .project-title { order: -1; width: 100%; margin: 0; font-size: 17px !important; font-weight: 500; letter-spacing: -0.01em; }
        .project-card .project-artist { margin-top: 6px; font-size: 11px; font-weight: 500; letter-spacing: 0.08em; color: rgba(255,255,255,0.55); }
        .project-card .project-role { margin-top: 6px !important; padding: 0 !important; border: none !important; font-size: 11px !important; letter-spacing: 0.08em; color: rgba(255,255,255,0.38); }
        .project-card .project-role::before { content: "·  "; }
        .project-card .project-description { display: none !important; }
        .project-card .project-play { opacity: 0; transition: opacity 0.3s ease; }
        .project-card:hover .project-play { opacity: 1; }
        .project-card:hover::before, .project-card:hover { box-shadow: none !important; }
        @media (max-width: 768px) {
            .projects-container, .projects-container.is-filtered { row-gap: 32px; }
            .project-media, .project-card.size-large .project-media, .project-card.as-large .project-media { aspect-ratio: 3 / 2; }
            .project-card .project-play { opacity: 0.9; }
        }
        body.bw .project-media img { filter: grayscale(1); transition: filter 0.5s ease, transform 0.8s ease; }
        body.bw .project-card:hover .project-media img { filter: none; }

        /* Selected Work (desktop): first 2 projects big side by side (3:2), then 3 per row (4:3) */
        @media (min-width: 769px) {
            .projects-container:not(.is-filtered) .project-card.project-card { grid-column: span 2; grid-row: auto; }
            .projects-container:not(.is-filtered) .project-card .project-media { aspect-ratio: 4 / 3; height: auto; }
            .projects-container:not(.is-filtered) .project-card.sw-top.sw-top { grid-column: span 3; }
            .projects-container:not(.is-filtered) .project-card.sw-top .project-media { aspect-ratio: 3 / 2; }
            .projects-container:not(.is-filtered) .project-card.sw-top .project-title { font-size: 20px !important; }
        }
        /* Description on hover, over the image */
        .project-overlay {
            position: absolute; inset: 0; z-index: 2;
            display: flex; align-items: flex-end; padding: 22px;
            background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.35) 55%, rgba(0,0,0,0.1) 100%);
            opacity: 0; transition: opacity 0.4s ease; pointer-events: none;
        }
        .project-overlay p {
            margin: 0; max-width: 560px; font-size: 13px; line-height: 1.55; color: rgba(255,255,255,0.88);
            display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
        }
        .project-card:hover .project-overlay { opacity: 1; }
        .project-card .project-play { z-index: 3; }
        .project-card:hover .project-artist { color: rgba(255,255,255,0.75); }
        @media (hover: none) { .project-overlay { display: none; } }

        /* Stage / Film & Commercials: plain 3-column grid, every card the same size */
        @media (min-width: 769px) {
            .projects-container.is-filtered .project-card,
            .projects-container.is-filtered .project-card.size-large.size-large,
            .projects-container.is-filtered .project-card.as-large.as-large { grid-column: span 2; grid-row: auto; }
            .projects-container.is-filtered .project-card .project-media,
            .projects-container.is-filtered .project-card.size-large .project-media { aspect-ratio: 4 / 3; height: auto; }
